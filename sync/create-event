#!/usr/bin/env python3
"""Create an appointment from the plugin UI, then refresh local events."""

import json
import subprocess
import sys
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from omarchy_calendar_sync import config as config_module  # noqa: E402
from omarchy_calendar_sync.caldav import CalDav, CalDavError  # noqa: E402
from omarchy_calendar_sync.cli import resolve_local_timezone  # noqa: E402


def escape(value):
    return str(value).replace("\\", "\\\\").replace("\n", "\\n").replace(";", "\\;").replace(",", "\\,")


def update_ical(raw, start_line, end_line, title, location):
    """Update a simple VEVENT while preserving its unrelated properties."""
    normalized = raw.replace("\r\n", "\n").replace("\r", "\n")
    lines = []
    for line in normalized.split("\n"):
        if line.startswith((" ", "\t")) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)
    if sum(1 for line in lines if line.upper() == "BEGIN:VEVENT") != 1 or any(line.upper().startswith("RRULE:") for line in lines):
        raise ValueError("Recurring appointments cannot be edited safely yet")
    controlled = {"DTSTART", "DTEND", "SUMMARY", "LOCATION"}
    output = []
    inside = False
    for line in lines:
        upper = line.upper()
        if upper == "BEGIN:VEVENT":
            inside = True
            output.append(line)
            continue
        if inside and upper == "END:VEVENT":
            output.extend([start_line, end_line, "SUMMARY:" + escape(title)])
            if location:
                output.append("LOCATION:" + escape(location))
            output.append(line)
            inside = False
            continue
        name = line.split(":", 1)[0].split(";", 1)[0].upper() if ":" in line else ""
        if inside and name in controlled:
            continue
        output.append(line)
    return "\r\n".join(output).rstrip("\r\n") + "\r\n"


def main():
    try:
        request = json.load(sys.stdin)
        title = str(request.get("title", "")).strip()
        day = str(request.get("dateKey", "")).strip()
        calendar_id = str(request.get("calendarId", "")).strip()
        location = str(request.get("location", "")).strip()
        all_day = bool(request.get("allDay", False))
        edit_url = str(request.get("resourceUrl", "")).strip()
        if not title:
            raise ValueError("Title is required")
        selected_date = datetime.strptime(day, "%Y-%m-%d").date()

        cfg = config_module.load()
        password = Path(cfg["passwordFile"]).expanduser().read_text().strip()
        client = CalDav(cfg["server"], cfg["username"], password)
        calendars = client.calendars()
        calendar = next((item for item in calendars if item["id"] == calendar_id), None)
        if calendar is None:
            calendar = calendars[0] if calendars else None
        if calendar is None:
            raise ValueError("No writable Nextcloud calendar was found")

        local_tz = resolve_local_timezone()
        if all_day:
            start_line = "DTSTART;VALUE=DATE:" + selected_date.strftime("%Y%m%d")
            end_line = "DTEND;VALUE=DATE:" + (selected_date + timedelta(days=1)).strftime("%Y%m%d")
        else:
            start_time = datetime.strptime(str(request.get("start", "")), "%H:%M").time()
            end_time = datetime.strptime(str(request.get("end", "")), "%H:%M").time()
            start = datetime.combine(selected_date, start_time, local_tz)
            end = datetime.combine(selected_date, end_time, local_tz)
            if end <= start:
                raise ValueError("End time must be after start time")
            start_line = "DTSTART:" + start.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            end_line = "DTEND:" + end.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")

        if edit_url:
            original = client.resource(edit_url)
            client.update_resource(edit_url, update_ical(original, start_line, end_line, title, location))
        else:
            uid = str(uuid.uuid4()) + "@omarchy-nextcloud-calendar"
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Omarchy//Nextcloud Calendar//EN",
                     "CALSCALE:GREGORIAN", "BEGIN:VEVENT", "UID:" + uid, "DTSTAMP:" + stamp,
                     start_line, end_line, "SUMMARY:" + escape(title)]
            if location:
                lines.append("LOCATION:" + escape(location))
            lines.extend(["END:VEVENT", "END:VCALENDAR", ""])
            client.create_event(calendar, "\r\n".join(lines))

        sync = subprocess.run([str(ROOT / "omarchy-calendar-sync")], text=True, capture_output=True)
        if sync.returncode:
            raise RuntimeError("Appointment was created, but refreshing failed: " + (sync.stderr.strip() or "unknown error"))
        print(("Appointment updated in " if edit_url else "Appointment added to ") + calendar["name"])
        return 0
    except (ValueError, OSError, json.JSONDecodeError, CalDavError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
